# OpenAI API Configuration for IMD Care
# Add your real OpenAI API Key below to enable live OpenAI completions.
# If left blank, IMD Care operates in full offline Demo Mode with pre-vetted synthetic clinical examples.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google MedGemma Clinical AI Configuration (Optional)
# Point to your deployed MedGemma vLLM, Vertex AI, or HuggingFace inference endpoint:
MEDGEMMA_API_ENDPOINT=
MEDGEMMA_API_KEY=
MEDGEMMA_MODEL=google/medgemma-2b

# Developer Monitoring Security Key (Restricted to Authorized Team Developers)
DEV_ACCESS_KEY=imd-dev-hackathon-2026

# Supabase Authentication Configuration (Optional for Public Browse, Required for Live User Accounts)
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy your Project URL and anon public key below:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
